---
import Base from '../../layouts/Base.astro';
import SpeciesChecklist from '../../components/SpeciesChecklist.astro';
import SiteCard from '../../components/SiteCard.astro';
import { itineraryWithSpecies, sites, regions, siteSpecies, fmtDateRu, dayLabel, plural, type DayWithSpecies } from '@lib/data';
export function getStaticPaths() {
  const all = itineraryWithSpecies();
  return all.map((d, i) => ({ params: { date: d.day.date }, props: { d, prev: all[i - 1] ?? null, next: all[i + 1] ?? null } }));
}
interface Props { d: DayWithSpecies; prev: DayWithSpecies | null; next: DayWithSpecies | null }
const { d, prev, next } = Astro.props;
const day = d.day;
const siteOf = Object.fromEntries(sites().map((s) => [s.id, s]));
const daySites = day.sites.map((id) => siteOf[id]).filter(Boolean);
const region = regions().find((r) => r.id === day.region);
const ss = siteSpecies();
const base = import.meta.env.BASE_URL;
const n = d.species.length;
const nE = d.species.filter((s) => s.isNew).length;
const items = d.species.map((s) => ({ id: s.id, n: s.n, highlight: s.highlightAt.length > 0, isNew: s.isNew }));
const short = (x: DayWithSpecies) => `${fmtDateRu(x.day.date, false)} · ${dayLabel(x.day)}`;
---
<Base title={`${fmtDateRu(day.date, false)}: ${day.title_ru}`} description={`${dayLabel(day)}: ${day.title_ru}. Локации и вероятные виды.`}>
  <nav class="pn top-pn">
    {prev ? <a href={`${base}days/${prev.day.date}/`}>← {short(prev)}</a> : <a href={base}>← Маршрут</a>}
    {next ? <a href={`${base}days/${next.day.date}/`}>{short(next)} →</a> : <span />}
  </nav>
  <p class="muted meta" style={`border-left:4px solid ${region?.color ?? 'var(--line)'}`}>
    {fmtDateRu(day.date)} · {dayLabel(day)}{region && <> · {region.name_ru}</>}
  </p>
  <h1>{day.title_ru}</h1>
  <table class="facts">
    {day.guide && <tr><th>Гид</th><td>{day.guide}</td></tr>}
    {day.travel_ru && <tr><th>Переезды</th><td>{day.travel_ru}</td></tr>}
    <tr><th>Ночёвка</th><td>{day.overnight_site && siteOf[day.overnight_site] ? <a href={`${base}sites/${day.overnight_site}/`}>{day.overnight}</a> : day.overnight}{day.elev_sleep != null && <span class="muted"> · {day.elev_sleep} м</span>}</td></tr>
  </table>

  {daySites.length > 0 && (
    <>
      <h2>{daySites.length === 1 ? 'Локация' : 'Локации'}</h2>
      <div class="grid">{daySites.map((s) => <SiteCard s={s} />)}</div>
    </>
  )}

  <h2>Виды дня</h2>
  {n === 0 ? (
    <p class="card muted">{daySites.length ? 'Для локаций этого дня нет данных GBIF.' : 'Птичьих локаций в этот день нет.'}</p>
  ) : (
    <>
      <p class="summary">
        ~{n} {plural(n, 'вероятный вид', 'вероятных вида', 'вероятных видов')}, <b class="hl">{d.nHighlights} {plural(d.nHighlights, 'изюминка', 'изюминки', 'изюминок')}</b>{nE < n && <>, {nE} {plural(nE, 'новый', 'новых', 'новых')}</>}
      </p>
      <p class="muted small">
        Вероятные — виды, у которых в GBIF ≥ 3 записи в радиусе {[...new Set(day.sites.map((id) => ss[id]?.radius_km).filter(Boolean))].join('/')} км от локаций дня (за все годы и сезоны, поэтому в списке есть редкие и залётные).
        Изюминки — целевые виды из отчётов о поездках. «Новый» — вида не было в списках предыдущих дней.
      </p>
      <SpeciesChecklist items={items} showNew={nE < n} />
    </>
  )}

  <nav class="pn">
    {prev ? <a href={`${base}days/${prev.day.date}/`}>← {short(prev)}</a> : <a href={base}>← Маршрут</a>}
    {next ? <a href={`${base}days/${next.day.date}/`}>{short(next)} →</a> : <a href={base}>Маршрут →</a>}
  </nav>
</Base>
<style>
  .meta { padding-left: 8px; margin-bottom: 4px; }
  .facts th { width: 100px; color: var(--muted); font-weight: 500; }
  .summary { font-size: 1.05rem; margin: 4px 0; }
  .hl { color: var(--accent-2); }
  .small { font-size: .85rem; }
  .pn { display: flex; justify-content: space-between; gap: 12px; margin-top: 24px; padding-top: 4px; border-top: 1px solid var(--line); }
  .pn a { min-height: 44px; display: inline-flex; align-items: center; }
  .pn a:last-child { text-align: right; }
  .top-pn { margin: -8px 0 4px; border-top: none; font-size: .9rem; }
</style>
