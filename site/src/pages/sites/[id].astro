---
import Base from '../../layouts/Base.astro';
import SpeciesChecklist from '../../components/SpeciesChecklist.astro';
import ScopeFilter from '../../components/ScopeFilter.svelte';
import FilterScope from '../../components/FilterScope.astro';
import RouteSort from '../../components/RouteSort.astro';
import { sites, regions, siteSpecies, speciesForSites, daysForSite, siteDaysShort, sortSitesByRoute, routeAttrs, hotspotCheck, isOptionalSite, OPTIONAL_SITES_RU, OPTIONAL_SITE_TAG_RU, defaultCounts, listFacets, speciesIndex, fmtDateRu, dayLabel, plural, type Site } from '@lib/data';
export function getStaticPaths() {
  return sites().map((s) => ({ params: { id: s.id }, props: { s } }));
}
const { s } = Astro.props as { s: Site };
const region = regions().find((r) => r.id === s.region);
const gb = siteSpecies()[s.id];
const items = speciesForSites([s.id]);
const dc = defaultCounts(items);
const famOf = new Map(speciesIndex().map((x) => [x.id, x.family]));
const facets = listFacets(items.map((x) => ({ id: x.id, family: famOf.get(x.id) ?? '', sites: [] })), []);
const nVis = dc.total;
const days = daysForSite(s.id);
const others = sites().filter((o) => o.region === s.region && o.id !== s.id);
// «Рядом»: by route day (today, upcoming, past most recent first), re-sorted in the browser by RouteSort
const othersTour = others.filter((o) => !isOptionalSite(o.id));
const othersTourSorted = sortSitesByRoute(othersTour.map((o, i) => ({ id: o.id, o, i })));
const othersOpt = others.filter((o) => isOptionalSite(o.id));
const opt = isOptionalSite(s.id);
const base = import.meta.env.BASE_URL;
const elev = s.elev_min != null ? (s.elev_max != null && s.elev_max !== s.elev_min ? `${s.elev_min}–${s.elev_max} м` : `${s.elev_min} м`) : null;
const gbifUrl = `https://www.gbif.org/occurrence/search?taxon_key=212&country=CO&has_coordinate=true&lat=${s.lat - (gb?.radius_km ?? 12) / 111},${s.lat + (gb?.radius_km ?? 12) / 111}&lng=${s.lon - (gb?.radius_km ?? 12) / 111},${s.lon + (gb?.radius_km ?? 12) / 111}`;
---
<Base title={s.name_ru || s.name} description={`${s.name}: высоты, биотоп, eBird-хотспоты и вероятные виды`}>
  <p class="muted meta" style={`border-left:4px solid ${region?.color ?? 'var(--line)'}`}>{region?.name_ru ?? s.region} · {s.department}</p>
  <h1>{s.name}</h1>
  {s.name_ru && s.name_ru !== s.name && <p class="ru">{s.name_ru}</p>}
  <table class="facts">
    {elev && <tr><th>Высота</th><td>{elev}</td></tr>}
    {s.habitat_ru && <tr><th>Биотоп</th><td>{s.habitat_ru}</td></tr>}
    <tr><th>Координаты</th><td>
      <a href={`https://www.openstreetmap.org/?mlat=${s.lat}&mlon=${s.lon}#map=12/${s.lat}/${s.lon}`} target="_blank" rel="noopener">{s.lat.toFixed(3)}, {s.lon.toFixed(3)}</a>
      {s.coords_approx && <span class="muted"> (примерно)</span>}
    </td></tr>
    {days.length > 0 && <tr><th>В маршруте</th><td>{days.map((d) => <a class="chip tap" href={`${base}days/${d.date}/`}>{fmtDateRu(d.date, false)} · {dayLabel(d)}</a>)}</td></tr>}
    {days.length === 0 && <tr><th>В маршруте</th><td class="muted">{opt ? `${OPTIONAL_SITE_TAG_RU}, возможный самостоятельный выезд из Боготы` : 'нет в плане'}</td></tr>}
  </table>
  {s.notes_ru && <p>{s.notes_ru}</p>}
  {s.ebird_hotspots?.length > 0 && (
    <p class="hs">{s.ebird_hotspots.map((h) => {
      const c = hotspotCheck(h.id);
      const nsp = c?.numSpeciesAllTime;
      return <a class="chip tap" href={`https://ebird.org/hotspot/${h.id}`} target="_blank" rel="noopener" title={c?.name_api ?? h.name}><span class="hsn">eBird: {h.name}</span>{nsp != null && <span class="hsc">{nsp} {plural(nsp, 'вид', 'вида', 'видов')}</span>}</a>;
    })}</p>
  )}
  {s.sources?.length > 0 && (
    <p class="muted small">Источники: {s.sources.map((u, i) => <>{i > 0 && ', '}<a href={u} target="_blank" rel="noopener">{new URL(u).hostname.replace(/^www\./, '')}</a></>)}</p>
  )}

  {items.length === 0 ? <><h2>Виды</h2><p class="card muted">Данных пока нет.</p></> : (
    <FilterScope ctx={facets.ctx}>
      <h2 class="vh">Виды <span class="cnt muted" data-lf-summary>{nVis} {plural(nVis, 'вид', 'вида', 'видов')}{dc.interesting > 0 && ` · ${dc.interesting} ${plural(dc.interesting, 'интересный', 'интересных', 'интересных')}`}</span></h2>
      <ScopeFilter client:load fams={facets.fams} sites={facets.sites} total={items.length} />
      <SpeciesChecklist items={items} fa={(x) => facets.attrs(x, [], { alt: true, sci: true })} />
    </FilterScope>
  )}

  {othersTour.length > 0 && (
    <>
      <h2>Рядом, {region?.name_ru}</h2>
      <p>{othersTourSorted.map(({ o, i }) => <a class="chip tap" href={`${base}sites/${o.id}/`} {...routeAttrs(o.id, i)}>{o.name_ru || o.name}{siteDaysShort(o.id) && <span class="sdays">{siteDaysShort(o.id)}</span>}</a>)}</p>
      <RouteSort />
    </>
  )}
  {othersOpt.length > 0 && (
    <>
      <h2>{OPTIONAL_SITES_RU}</h2>
      <p>{othersOpt.map((o) => <a class="chip tap" href={`${base}sites/${o.id}/`}>{o.name_ru || o.name}{siteDaysShort(o.id) && <span class="sdays">{siteDaysShort(o.id)}</span>}</a>)}</p>
    </>
  )}
  <p><a href={base}>← Маршрут</a></p>
  {gb && (
    <p class="muted small method">
      По <a href={gbifUrl} target="_blank" rel="noopener">GBIF</a>: {gb.total_records.toLocaleString('ru-RU')} записей птиц в радиусе {gb.radius_km} км{gb.total_records_aut != null && <>, из них осенних {gb.total_records_aut.toLocaleString('ru-RU')}</>}; в списке виды с ≥ 3 записями, данные на {gb.retrieved}.
 «Точно» — не меньше 1 % осенних (сентябрь–ноябрь) записей, «возможно» — 0,1–1 %, «вряд ли» — реже или нет записей. ★ интересные — цели из отчётов о поездках и виды с узким ареалом; эндемики (◆) и почти-эндемики (◇) интересны всегда и отмечены ромбом вместо звезды.
    </p>
  )}
</Base>
<style>
  .meta { padding-left: 8px; margin-bottom: 4px; }
  .ru { margin: -6px 0 8px; font-weight: 600; }
  .facts th { width: 110px; color: var(--muted); font-weight: 500; }
  .facts .chip { margin: 2px 6px 2px 0; }
  .vh { margin-bottom: 2px; }
  .vh .cnt { font-size: .9rem; font-weight: 500; margin-left: 6px; white-space: nowrap; }
  .small { font-size: .85rem; }
  .hs a.chip.tap { max-width: 100%; gap: 8px; }
  .hsn { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .hsc { color: var(--muted); white-space: nowrap; font-size: .8rem; }
  .method { margin-top: 16px; }
</style>
