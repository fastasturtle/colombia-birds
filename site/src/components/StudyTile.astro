---
/**
 * Photo tile for the day study page. The photo opens photo 1 full screen via ThumbLightbox.svelte
 * (the page must mount it once); the name links to the species page. Badges: ★ highlight,
 * «энд.» endemic, «нов.» new for the route. `small` = compact tile for the background list.
 */
import { mediaUrl, species, type IndexEntry } from '@lib/data';
interface Props { s: IndexEntry; highlight?: boolean; endemic?: boolean; isNew?: boolean; small?: boolean }
const { s, highlight = false, endemic = false, isNew = false, small = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}species/${s.id}/`;
const p = s.photo ? species(s.id).photos[0] : null;
const lb = p && JSON.stringify({ alt: [s.en, s.ru].filter(Boolean).join(' · '), photo: { sizes: p.sizes, author: p.author, license: p.license, license_url: p.license_url, source_url: p.source_url } });
const badges = highlight || endemic || isNew;
---
<div class:list={['tile', { small }]}>
  {p ? (
    <button type="button" class="ph" data-lb={lb} aria-label={`Фото: ${s.en}, на весь экран`}>
      <img src={mediaUrl(s.photo!)} alt="" loading="lazy" />
    </button>
  ) : (
    <a class="ph empty" href={href} aria-hidden="true" tabindex="-1">🐦</a>
  )}
  {badges && (
    <span class="badges">
      {highlight && <span class="b hl" title="изюминка">★</span>}
      {endemic && <span class="b en" title="эндемик Колумбии">энд.</span>}
      {isNew && <span class="b nw" title="новый для маршрута">нов.</span>}
    </span>
  )}
  <a class="nm" href={href}>
    <span class="en">{s.en}</span>
    {s.ru && <span class="ru">{s.ru}</span>}
  </a>
</div>
<style>
  .tile { position: relative; min-width: 0; display: flex; flex-direction: column; font-size: .78rem; line-height: 1.25; }
  .ph { display: block; width: 100%; aspect-ratio: 1; padding: 0; border: 0; border-radius: 10px; overflow: hidden;
    background: var(--chip); cursor: zoom-in; line-height: 0; }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ph.empty { display: grid; place-items: center; color: var(--muted); font-size: 1.6rem; cursor: pointer; line-height: 1; }
  .ph.empty:hover { text-decoration: none; }
  .badges { position: absolute; top: 4px; left: 4px; display: flex; gap: 3px; pointer-events: none; }
  .b { font-size: .68rem; font-weight: 700; line-height: 1; padding: 3px 5px; border-radius: 6px; color: #fff; background: rgba(0,0,0,.6); }
  .b.hl { background: var(--accent-2); }
  .b.en { background: #14532d; }
  .b.nw { background: rgba(0,0,0,.62); }
  .nm { color: inherit; display: flex; flex-direction: column; padding: 4px 0 2px; min-height: 40px; }
  .nm:hover { text-decoration: none; }
  .nm:hover .en { text-decoration: underline; }
  .en, .ru { overflow-wrap: anywhere; hyphens: auto; }
  .en { font-weight: 600; }
  .ru { color: var(--muted); }
  .small { font-size: .72rem; }
  .small .ph { border-radius: 8px; }
</style>
