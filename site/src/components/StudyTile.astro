---
/**
 * Photo tile for the day page. The photo opens photo 1 full screen via ThumbLightbox.svelte
 * (the page must mount it once); the name (Russian, then English) links to the species page. Badges: ★ «интересная», ◆ endemic, ◇ near-endemic (EndemicMark);
 * under the name the likelihood word. Carries data-st / data-int / data-nend / data-end / data-new for the site-wide filter (FilterScope).
 */
import StateWord from './StateWord.astro';
import EndemicMark from './EndemicMark.svelte';
import { mediaUrl, species, speciesNames, WHY_RU, type IndexEntry, type State, type Why } from '@lib/data';
interface Props { s: IndexEntry; state: State; why?: Why[]; isNew?: boolean }
const { s, state, why = [], isNew = false } = Astro.props;
const interesting = why.length > 0;
const base = import.meta.env.BASE_URL;
const href = `${base}species/${s.id}/`;
const nm = speciesNames(s);
const p = s.photo ? species(s.id).photos[0] : null;
const lb = p && JSON.stringify({ alt: [nm.main, nm.alt].filter(Boolean).join(' · '), photo: { sizes: p.sizes, author: p.author, license: p.license, license_url: p.license_url, source_url: p.source_url } });
---
<div class="tile" data-st={state} data-int={interesting ? '' : undefined} data-nend={s.endemic || s.near_endemic ? '' : undefined} data-end={s.endemic ? '' : undefined} data-new={isNew ? '' : undefined}>
  {p ? (
    <button type="button" class="ph" data-lb={lb} aria-label={`Фото: ${nm.main}, на весь экран`}>
      <img src={mediaUrl(s.photo!)} alt="" loading="lazy" />
    </button>
  ) : (
    <a class="ph empty" href={href} aria-hidden="true" tabindex="-1">🐦</a>
  )}
  {(interesting || s.endemic || s.near_endemic) && (
    <span class="badges">
      {interesting && <span class="b hl" title={`интересная: ${why.map((w) => WHY_RU[w]).join(', ')}`}>★</span>}
      {s.endemic && <EndemicMark kind="end" variant="tile" />}
      {s.near_endemic && !s.endemic && <EndemicMark kind="near" variant="tile" />}
    </span>
  )}
  <a class="nm" href={href}>
    <span class="pri">{nm.main}</span>
    {nm.alt && <span class="sec">{nm.alt}</span>}
  </a>
  <StateWord state={state} />
</div>
<style>
  .tile { position: relative; min-width: 0; display: flex; flex-direction: column; font-size: .78rem; line-height: 1.25; }
  .ph { display: block; width: 100%; aspect-ratio: 1; padding: 0; border: 0; border-radius: 10px; overflow: hidden;
    background: var(--chip); cursor: zoom-in; line-height: 0; }
  .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ph.empty { display: grid; place-items: center; color: var(--muted); font-size: 1.6rem; cursor: pointer; line-height: 1; }
  .ph.empty:hover { text-decoration: none; }
  .badges { position: absolute; top: 4px; left: 4px; display: flex; gap: 3px; pointer-events: none; }
  .b { font-size: .68rem; font-weight: 700; line-height: 1; padding: 3px 5px; border-radius: 6px; color: #fff; background: rgba(0,0,0,.6); }
  .b.hl { background: var(--accent-2); }
  .nm { color: inherit; display: flex; flex-direction: column; padding: 4px 0 1px; }
  .nm:hover { text-decoration: none; }
  .nm:hover .pri { text-decoration: underline; }
  .pri, .sec { overflow-wrap: anywhere; hyphens: auto; }
  .pri { font-weight: 600; }
  .sec { color: var(--muted); }
</style>
