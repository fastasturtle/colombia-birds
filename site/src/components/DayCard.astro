---
import { sites, regions, siteDaysShort, studyList, defaultCounts, fmtDateRu, dayLabel, plural, weatherDay, wmo, type DayWithSpecies } from '@lib/data';
interface Props { d: DayWithSpecies; compact?: boolean; id?: string; hidden?: boolean }
const { d, compact = false, id, hidden } = Astro.props;
const day = d.day;
const siteOf = Object.fromEntries(sites().map((s) => [s.id, s]));
const color = regions().find((r) => r.id === day.region)?.color ?? 'var(--line)';
const base = import.meta.env.BASE_URL;
const study = studyList(day.date);
// counts under the default filter (level «Все»: «интересных» over every species of the day), static: the card has no JS
const c = study ? defaultCounts(study.species) : null;
// one-glance forecast of the day's first location (data/weather.json): worst weather, temperature range, max rain
// chance; shown right of the site chips (free space, no extra line), on the Ночёвка line when there are no sites
const wx = (() => {
  const ps = Object.values(weatherDay(day.date)?.[0]?.periods ?? {}).filter((p) => p != null);
  if (!ps.length) return null;
  const code = Math.max(...ps.map((p) => p.weather_code ?? -1));
  const lo = Math.min(...ps.map((p) => p.t_min)), hi = Math.max(...ps.map((p) => p.t_max));
  const probs = ps.map((p) => p.precip_prob).filter((x): x is number => x != null);
  const prob = probs.length ? Math.max(...probs) : null;
  const w = wmo(code < 0 ? null : code);
  return { icon: w.icon, t: lo === hi ? `${hi}°` : `${lo}–${hi}°`, prob,
    title: `Прогноз, ${weatherDay(day.date)![0].name_ru}: ${w.ru}${prob != null ? `, осадки до ${prob}%` : ''}` };
})();
---
<article class="card daycard" id={id} hidden={hidden} data-date={day.date} style={`border-left: 5px solid ${color}`}>
  <slot name="top" />
  <a class="dhead" href={`${base}days/${day.date}/`}>
    <span class="muted meta">{fmtDateRu(day.date)} · {dayLabel(day)}{day.guide && <> · гид {day.guide}</>}</span>
    <strong class="dtitle">{day.title_ru}</strong>
  </a>
  {!compact && day.travel_ru && <div class="muted small">{day.travel_ru}</div>}
  <div class="muted small">Ночёвка: {day.overnight}{day.elev_sleep != null && <> · {day.elev_sleep}&nbsp;м</>}{wx && day.sites.length === 0 && <span class="wx" title={wx.title}> · {wx.icon} {wx.t}{wx.prob != null && ` ${wx.prob}%`}</span>}</div>
  {day.sites.length > 0 && (
    <div class="sites">{day.sites.map((sid) => siteOf[sid] && <a class="chip tap" href={`${base}sites/${sid}/`}>{siteOf[sid].name_ru || siteOf[sid].name}{siteDaysShort(sid, day.date) && <span class="sdays">{siteDaysShort(sid, day.date)}</span>}</a>)}{wx && <span class="wx small muted" title={wx.title}>{wx.icon} {wx.t}{wx.prob != null && ` ${wx.prob}%`}</span>}</div>
  )}
  {c && c.sure + c.maybe + c.interesting > 0 && (
    <div class="small stats">
      <b class="sure">{c.sure} точно</b> · {c.maybe} возможно{c.interesting > 0 && <> · <b class="hl">{c.interesting} {plural(c.interesting, 'интересный', 'интересных', 'интересных')}</b></>}
    </div>
  )}
  <slot />
</article>
<style>
  .daycard { margin: 8px 0; }
  .dhead { display: block; color: inherit; padding: 2px 0 4px; }
  .dhead:hover { text-decoration: none; }
  .dhead:hover .dtitle { color: var(--accent); }
  .meta { display: block; font-size: .85rem; }
  .dtitle { display: block; font-size: 1.05rem; line-height: 1.3; }
  .small { font-size: .9rem; }
  .sites { margin-top: 6px; display: flex; flex-wrap: wrap; align-items: center; }
  .sites .wx { margin: 0 0 6px auto; padding-left: 4px; }
  .stats { margin-top: 2px; }
  .hl { color: var(--accent-2); }
  .sure { color: var(--accent); }
  .wx { white-space: nowrap; }
</style>
