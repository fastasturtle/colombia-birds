---
/**
 * The old identifier (/identify/) moved into the shared filter bar: «Признаки» on /species/ and on every list.
 * This page only keeps old links and bookmarks working: it sends the visitor to /species/?panel=traits (FilterBar
 * opens the panel and «Признаки»). A selection the old page saved in localStorage `cb.identify` ({place, sel}) is
 * carried over once: sel -> `t=group:v,v;…`, the place (a day or a site) -> `site=…`; then the key is removed.
 * Meta refresh + a visible link without JS. Standalone HTML (no Base): nothing here is worth a layout.
 */
import { itinerary } from '@lib/data';

const base = import.meta.env.BASE_URL;
const target = `${base}species/?panel=traits`;
// day:<date> -> its sites, for the carried-over place
const days: Record<string, string[]> = Object.fromEntries(itinerary().filter((d) => d.sites.length).map((d) => [d.date, d.sites]));
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Определитель переехал · Птицы Колумбии</title>
    <link rel="canonical" href={`${Astro.site?.origin ?? ''}${base}species/`} />
    <script is:inline define:vars={{ target, days }}>
      var url = new URL(target, location.href);
      try {
        var v = JSON.parse(localStorage.getItem('cb.identify') || 'null');
        if (v && v.sel && typeof v.sel === 'object') {
          var t = Object.keys(v.sel).filter(function (g) { return Array.isArray(v.sel[g]) && v.sel[g].length; })
            .map(function (g) { return g + ':' + v.sel[g].join(','); }).join(';');
          if (t) url.searchParams.set('t', t);
        }
        var p = v && typeof v.place === 'string' ? v.place : '';
        var site = p.indexOf('site:') === 0 ? p.slice(5) : p.indexOf('day:') === 0 ? (days[p.slice(4)] || []).join(',') : '';
        if (site) url.searchParams.set('site', site);
        localStorage.removeItem('cb.identify');
      } catch (e) { /* private mode, bad JSON */ }
      location.replace(url.href);
    </script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <style is:inline>
      body { margin: 0; padding: 24px 16px; font: 16px/1.5 system-ui, sans-serif; background: #f7f6f2; color: #1c1f1a; }
      a { color: #14532d; }
      @media (prefers-color-scheme: dark) { body { background: #10150f; color: #e6e9e3; } a { color: #86d19a; } }
    </style>
  </head>
  <body>
    <p><a href={target}>Определитель переехал на страницу видов</a>: признаки теперь в «Фильтрах» любого списка.</p>
  </body>
</html>
