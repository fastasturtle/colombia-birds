---
/**
 * Species list row. The thumbnail (when there is a photo) opens photo 1 full screen via
 * ThumbLightbox.svelte, which the page must mount once; the name links to the species page.
 * With `state`, the row shows the likelihood word and carries data-st / data-int / data-nend / data-end for the site-wide filter.
 */
import StateWord from './StateWord.astro';
import EndemicMark from './EndemicMark.svelte';
import { mediaUrl, species, speciesNames, WHY_RU, type IndexEntry, type State, type Why } from '@lib/data';
interface Props { s: IndexEntry; state?: State; why?: Why[] }
const { s, state, why = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const nm = speciesNames(s);
const p = s.photo ? species(s.id).photos[0] : null;
const lb = p && JSON.stringify({ alt: [nm.main, nm.alt].filter(Boolean).join(' · '), photo: { sizes: p.sizes, author: p.author, license: p.license, license_url: p.license_url, source_url: p.source_url } });
const href = `${base}species/${s.id}/`;
---
<div class="row" data-st={state} data-int={state && why.length ? '' : undefined} data-nend={state && (s.endemic || s.near_endemic) ? '' : undefined} data-end={state && s.endemic ? '' : undefined}>
  {p ? (
    <button type="button" class="thumb-btn" data-lb={lb} aria-label={`Фото: ${nm.main}, на весь экран`}>
      <img class="thumb" src={mediaUrl(s.photo!)} alt="" loading="lazy" />
    </button>
  ) : (
    <a href={href} class="thumb empty" aria-hidden="true" tabindex="-1">🐦</a>
  )}
  <a class="txt" href={href}>
    <div>{why.length > 0 && <b class="star" title={`интересная: ${why.map((w) => WHY_RU[w]).join(', ')}`}>★ </b>}<strong>{nm.main}</strong></div>
    <div class="muted">{nm.alt && <>{nm.alt} · </>}<span class="sci">{s.sci}</span></div>
    <div class="meta">
      {state && <StateWord state={state} />}
      {s.endemic && <EndemicMark kind="end" />}
      {s.near_endemic && !s.endemic && <EndemicMark kind="near" />}
      {s.elev && (s.elev[0] != null || s.elev[1] != null) && <span class="muted">{s.elev[0] ?? 0}–{s.elev[1] ?? '?'} м</span>}
    </div>
  </a>
</div>
<style>
  .txt { color: inherit; flex: 1; min-width: 0; align-self: stretch; display: flex; flex-direction: column; justify-content: center; }
  .txt:hover { text-decoration: none; }
  .row:hover { background: var(--chip); }
  .thumb-btn { padding: 0; border: 0; background: none; cursor: zoom-in; flex: none; border-radius: 8px; line-height: 0; }
  .thumb-btn img { display: block; }
  a.thumb.empty:hover { text-decoration: none; }
  .meta { display: flex; flex-wrap: wrap; gap: 2px 8px; align-items: center; font-size: .8rem; }
  .star { color: var(--accent-2); }
</style>
