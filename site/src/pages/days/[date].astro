---
/**
 * Day page = a short study page for the evening before: facts, the day's sites, and «Виды дня»
 * (data/study_lists.json: every species of the day's sites with state + «интересная»), grouped by bird group,
 * filtered by the shared FilterBar (ScopeFilter.svelte). No study list -> no species section.
 */
import Base from '../../layouts/Base.astro';
import SiteCard from '../../components/SiteCard.astro';
import WeatherDay from '../../components/WeatherDay.astro';
import StudyTile from '../../components/StudyTile.astro';
import ThumbLightbox from '../../components/ThumbLightbox.svelte';
import ScopeFilter from '../../components/ScopeFilter.svelte';
import EndemicMark from '../../components/EndemicMark.svelte';
import FilterScope from '../../components/FilterScope.astro';
import {
  itinerary, sites, regions, siteSpecies, speciesIndex, groups, groupOfFamily, studyList, defaultCounts, sitesListing, listFacets, fmtDateRu, dayLabel, plural, MEDIA_BASE,
  type Day, type IndexEntry, type StudyEntry,
} from '@lib/data';
export function getStaticPaths() {
  const all = itinerary();
  return all.map((d, i) => ({ params: { date: d.date }, props: { day: d, prev: all[i - 1] ?? null, next: all[i + 1] ?? null } }));
}
interface Props { day: Day; prev: Day | null; next: Day | null }
const { day, prev, next } = Astro.props;
const siteOf = Object.fromEntries(sites().map((s) => [s.id, s]));
const daySites = day.sites.map((id) => siteOf[id]).filter(Boolean);
const region = regions().find((r) => r.id === day.region);
const idx = new Map(speciesIndex().map((s) => [s.id, s]));
const base = import.meta.env.BASE_URL;
const study = studyList(day.date);

// all species of the day, grouped by bird group (groups.json order); inside a group the pipeline order
// (interesting first, then sure > maybe > unlikely, then autumn frequency)
const list = study?.species ?? [];
const studySites = study?.sites.length ? study.sites : day.sites;
const byGroup = new Map<string, { f: StudyEntry; s: IndexEntry; at: string[] }[]>();
for (const f of list) {
  const s = idx.get(f.id)!;
  const g = groupOfFamily(s.family)?.id ?? '';
  (byGroup.get(g) ?? byGroup.set(g, []).get(g)!).push({ f, s, at: sitesListing(s.id, studySites) });
}
const facets = listFacets([...byGroup.values()].flat().map((r) => ({ id: r.s.id, family: r.s.family, sites: r.at })), studySites);
const dayGroups = [...groups().map((g) => ({ id: g.id, name: g.name_ru })), { id: '', name: 'Прочие' }]
  .map((g) => ({ ...g, rows: byGroup.get(g.id) ?? [] }))
  .filter((g) => g.rows.length);
const hasPhotos = list.some((x) => idx.get(x.id)?.photo);
const dc = defaultCounts(list);
const nVis = dc.total;
const allNew = list.every((x) => x.new_for_route);
const ss = siteSpecies();
const radii = [...new Set(studySites.map((id) => ss[id]?.radius_km).filter(Boolean))];
const short = (d: Day) => `${fmtDateRu(d.date, false)} · ${dayLabel(d)}`;
---
<Base title={`${fmtDateRu(day.date, false)}: ${day.title_ru}`} description={`${dayLabel(day)}: ${day.title_ru}. Виды дня: кого увидим точно, кого возможно, кто интересен.`}>
  <header class="dh" style={`border-left-color:${region?.color ?? 'var(--line)'}`}>
    <p class="muted meta">{fmtDateRu(day.date)} · {dayLabel(day)}{region && <> · {region.name_ru}</>}</p>
    <h1>{day.title_ru}</h1>
  </header>
  <table class="facts">
    <tr><th>Гид</th><td>{day.guide ?? '—'}</td></tr>
    <tr><th>Переезды</th><td>{day.travel_ru || '—'}</td></tr>
    <tr><th>Ночёвка</th><td>{day.overnight_site && siteOf[day.overnight_site] ? <a href={`${base}sites/${day.overnight_site}/`}>{day.overnight}</a> : day.overnight}{day.elev_sleep != null && <span class="muted"> · {day.elev_sleep} м</span>}</td></tr>
  </table>
  <WeatherDay date={day.date} />

  {daySites.length > 0 && <div class="strip">{daySites.map((s) => <SiteCard s={s} />)}</div>}

  {study && dayGroups.length > 0 && (
    <section>
      <FilterScope ctx={facets.ctx}>
        <h2 class="vh">Виды дня <span class="cnt muted" data-lf-summary>{nVis} {plural(nVis, 'вид', 'вида', 'видов')}{dc.interesting > 0 && ` · ${dc.interesting} ${plural(dc.interesting, 'интересный', 'интересных', 'интересных')}`}</span></h2>
        {!allNew && <p class="muted newl" data-lf-new></p>}
        <ScopeFilter client:load fams={facets.fams} sites={facets.sites} total={list.length} />
        {dayGroups.map((g) => (
          <div data-lf-group>
            <h3 class="grp">{g.name}</h3>
            <div class="tiles">
              {g.rows.map(({ f, s, at }) => <StudyTile s={s} state={f.state} why={f.why} isNew={f.new_for_route} fa={facets.attrs(s, at, { alt: true })} />)}
            </div>
          </div>
        ))}
      </FilterScope>
    </section>
  )}

  {hasPhotos && <ThumbLightbox client:idle mediaBase={MEDIA_BASE} />}

  <nav class="pn">
    {prev ? <a href={`${base}days/${prev.date}/`}>← {short(prev)}</a> : <a href={base}>← Маршрут</a>}
    {next ? <a href={`${base}days/${next.date}/`}>{short(next)} →</a> : <a href={base}>Маршрут →</a>}
  </nav>
  {study && radii.length > 0 && (
    <p class="muted method">
      «Точно» — не меньше 1 % осенних (сентябрь–ноябрь) записей птиц GBIF в радиусе {radii.join('/')} км, «возможно» — 0,1–1 %, «вряд ли» — реже или нет записей. ★ интересные: цели из отчётов о поездках, виды с узким ареалом; эндемики (<EndemicMark kind="end" />) и почти-эндемики (<EndemicMark kind="near" />, основной ареал в Колумбии) интересны всегда и отмечены ромбом вместо звезды; по каждой локации — на {daySites.length === 1
        ? <a href={`${base}sites/${daySites[0].id}/`}>странице локации</a>
        : 'странице локации'}.
    </p>
  )}
</Base>
<style>
  .dh { border-left: 4px solid; padding-left: 10px; margin: 4px 0 10px; }
  .dh .meta { margin: 0 0 2px; font-size: .9rem; }
  .dh h1 { margin: 0; }
  .facts th { width: 96px; color: var(--muted); font-weight: 500; }
  .strip { display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); margin: 14px 0 4px; }
  .grp { font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); font-weight: 600; margin: 14px 0 6px; }
  .tiles { display: grid; gap: 10px 8px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (min-width: 640px) {
    .tiles { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 14px 12px; }
  }
  .vh { margin-bottom: 2px; }
  .vh .cnt { font-size: .9rem; font-weight: 500; margin-left: 6px; white-space: nowrap; }
  .newl { margin: 0; font-size: .85rem; }
  .pn { display: flex; justify-content: space-between; gap: 12px; margin-top: 24px; padding-top: 4px; border-top: 1px solid var(--line); }
  .pn a { min-height: 44px; display: inline-flex; align-items: center; }
  .pn a:last-child { text-align: right; }
  .method { font-size: .8rem; margin-top: 8px; }
</style>
