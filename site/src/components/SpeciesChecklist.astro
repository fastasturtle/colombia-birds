---
/**
 * Species of a place grouped by family in taxonomic order, following the site-wide filter
 * (wrap in FilterScope and mount ListFilter above). Rows carry data-st / data-int / data-nend / data-end; families are data-lf-group
 * with live counts. Long lists (>= collapseFrom) render every family as a closed <details>.
 */
import StateWord from './StateWord.astro';
import EndemicMark from './EndemicMark.svelte';
import { families, speciesIndex, speciesNames, mediaUrl, IUCN_RU, WHY_RU, plural, type IndexEntry, type State, type Why } from '@lib/data';
export interface Item { id: string; n: number; state: State; why: Why[] }
interface Props { items: Item[]; collapseFrom?: number }
const { items, collapseFrom = 300 } = Astro.props;
const idx = new Map(speciesIndex().map((s) => [s.id, s]));
const fams = new Map(families().map((f) => [f.code, f]));
const rows = items.map((it) => ({ ...it, s: idx.get(it.id)! })).filter((r) => r.s).map((r) => ({ ...r, nm: speciesNames(r.s) }))
  .sort((a, b) => a.s.taxon_order - b.s.taxon_order);
const groups: { code: string; rows: (Item & { s: IndexEntry; nm: { main: string; alt: string | null } })[] }[] = [];
for (const r of rows) {
  const g = groups.at(-1);
  if (g && g.code === r.s.family) g.rows.push(r);
  else groups.push({ code: r.s.family, rows: [r] });
}
const collapsed = rows.filter((r) => r.state !== 'unlikely').length >= collapseFrom; // what the default filter shows
const base = import.meta.env.BASE_URL;
const recs = (n: number) => (n > 0 ? `${n} ${plural(n, 'запись', 'записи', 'записей')} GBIF` : 'нет записей GBIF рядом');
---
{rows.length > 0 && (
  <div class="checklist">
    {groups.map((g) => {
      const f = fams.get(g.code);
      return (
        <details class="fam" open={!collapsed} data-lf-group>
          <summary>
            <span class="fname">{f?.names.ru ?? f?.names.en ?? g.code}</span>
            <span class="muted sci">{f?.sci}</span>
            <span class="cnt"><span data-lf-gcount>{g.rows.length}</span><b class="hl" data-lf-gint hidden></b></span>
          </summary>
          {g.rows.map((r) => (
            <a class="row sp" href={`${base}species/${r.s.id}/`} data-st={r.state} data-int={r.why.length ? '' : undefined} data-nend={r.s.endemic || r.s.near_endemic ? '' : undefined} data-end={r.s.endemic ? '' : undefined}>
              {r.s.photo ? <img class="thumb" src={mediaUrl(r.s.photo)} alt="" loading="lazy" width="48" height="48" /> : <span class="thumb empty" aria-hidden="true"></span>}
              <span class="txt">
                <span class="l1">{r.why.length > 0 && !r.s.endemic && !r.s.near_endemic && <b class="star" title={`интересная: ${r.why.map((w) => WHY_RU[w]).join(', ')}`}>★</b>}<strong>{r.nm.main}</strong></span>
                <span class="l2 muted">{r.nm.alt && <>{r.nm.alt} · </>}<span class="sci">{r.s.sci}</span></span>
                <span class="tags">
                  <StateWord state={r.state} title={recs(r.n)} />
                  {r.s.endemic && <EndemicMark kind="end" />}
                  {r.s.near_endemic && !r.s.endemic && <EndemicMark kind="near" />}
                  {r.s.iucn && r.s.iucn !== 'LC' && <span class="chip iucn" title={IUCN_RU[r.s.iucn]}>IUCN {r.s.iucn}</span>}
                </span>
              </span>
            </a>
          ))}
        </details>
      );
    })}
  </div>
)}
<style>
  .fam { border-bottom: 1px solid var(--line); }
  .fam summary {
    min-height: 44px; display: flex; flex-wrap: wrap; align-items: center; gap: 0 8px; cursor: pointer; padding: 6px 0;
    list-style: none;
  }
  .fam summary::-webkit-details-marker { display: none; }
  .fam summary::before { content: '▸'; color: var(--muted); width: 12px; transition: transform .15s; }
  .fam[open] > summary::before { transform: rotate(90deg); }
  .fname { font-weight: 600; }
  .fam summary .sci { font-size: .85rem; }
  .cnt { margin-left: auto; color: var(--muted); font-size: .85rem; white-space: nowrap; }
  .cnt .hl { color: var(--accent-2); font-weight: 600; }
  .sp { color: inherit; gap: 10px; padding: 6px 0; border-bottom: none; border-top: 1px solid var(--line); min-width: 0; }
  .sp:hover { text-decoration: none; background: var(--chip); }
  .sp .thumb { width: 48px; height: 48px; }
  .txt { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
  .l1, .l2 { overflow-wrap: anywhere; }
  .l2 { font-size: .82rem; }
  .tags { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 8px; margin-top: 2px; }
  .tags .chip { margin: 0; font-size: .72rem; padding: 1px 8px; }
  .chip.iucn { background: #b91c1c; color: #fff; }
  .star { color: var(--accent-2); margin-right: 4px; }
</style>
