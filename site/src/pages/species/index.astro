---
import Base from '../../layouts/Base.astro';
import SpeciesList from '../../components/SpeciesList.svelte';
import { speciesIndex, families } from '@lib/data';
const idx = speciesIndex();
const fams = Object.fromEntries(families().map((f) => [f.code, f.names.ru ?? f.names.en]));
---
<Base title="Все виды">
  <h1>Все виды</h1>
  <SpeciesList client:load items={idx} families={fams} base={import.meta.env.BASE_URL} mediaBase={import.meta.env.PUBLIC_MEDIA_BASE_URL ?? 'https://pub-5e58909dbd0e457c85e4e36ef2cdc583.r2.dev'} />
</Base>
