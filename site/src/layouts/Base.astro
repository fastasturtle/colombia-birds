---
import ReportButton from '../components/ReportButton.svelte';
interface Props { title: string; description?: string; species?: string }
const { title, description = 'Птицы Колумбии: справочник для нашего тура', species } = Astro.props;
const reportUrl = import.meta.env.PUBLIC_REPORT_URL;
const base = import.meta.env.BASE_URL;
const nav = [
  { href: `${base}`, label: 'Маршрут' },
  { href: `${base}species/`, label: 'Виды' },
  { href: `${base}seen/`, label: 'Увидели' },
  { href: `${base}families/`, label: 'Семейства' },
  { href: `${base}words/`, label: 'Слова' },
  { href: `${base}history/`, label: 'История' },
  { href: `${base}offline/`, label: 'Офлайн' },
];
const buildId = __BUILD_ID__;
const prod = import.meta.env.PROD;
const path = Astro.url.pathname;
// current section: «Маршрут» also covers day and site pages
const isCur = (href: string) => (href === base ? path === base || path.startsWith(`${base}days/`) || path.startsWith(`${base}sites/`) : path.startsWith(href));
// the first two sections stay in the header, the rest go into the ☰ menu (its button names the current one)
const [navMain, navMore] = [nav.slice(0, 2), nav.slice(2)];
const curMore = navMore.find((n) => isCur(n.href));
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#14532d" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="build-version" content={buildId} />
    <title>{title} · Птицы Колумбии</title>
    <script is:inline>
      // Place lists by route day (RouteSort.astro calls this right after a list, before first paint): re-sorts the
      // box's children that carry data-rd (route dates) / data-ri (order before sorting) against Bogotá today, the
      // rule of lib/dates routeRank, so a page cached offline days ago is still right. Other children stay put.
      window.routeSort = function (box) {
        try {
          var t = Date.parse(new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Bogota' }).format(new Date()));
          var els = box && !isNaN(t) ? [].slice.call(box.querySelectorAll(':scope > [data-rd]')) : [];
          var rank = function (e) { return e.dataset.rd.split(' ').reduce(function (b, d) { var n = Math.round((Date.parse(d) - t) / 864e5); return Math.min(b, n >= 0 ? n : 1e5 - n); }, 1e9); };
          var marks = els.map(function (e) { var m = document.createComment(''); e.before(m); return m; });
          els.map(function (e) { return [rank(e), +e.dataset.ri, e]; }).sort(function (a, b) { return a[0] - b[0] || a[1] - b[1]; })
            .forEach(function (x, i) { marks[i].replaceWith(x[2]); });
        } catch (e) {}
      };
    </script>
  </head>
  <body>
    <header class="top">
      <div class="top-inner">
        <a class="brand" href={base}>Птицы Колумбии</a>
        <a class="offline-strip" id="offline-strip" href={`${base}offline/`} hidden>Офлайн · <span>пакет не скачан</span></a>
        <div class="nv-pill" id="new-version" role="status" hidden><button type="button" class="nv-reload">Есть новая версия · <b>Обновить</b></button><button type="button" class="nv-close" aria-label="Скрыть">×</button></div>
        <nav aria-label="Разделы">
          {navMain.map((n) => <a href={n.href} aria-current={isCur(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <details class="menu">
            <summary class:list={{ cur: curMore }} aria-label={curMore ? `Ещё разделы, сейчас: ${curMore.label}` : 'Ещё разделы'}><span aria-hidden="true">☰</span>{curMore && <span class="menu-cur">{curMore.label}</span>}</summary>
            <div class="menu-pop">
              {navMore.map((n) => <a href={n.href} aria-current={isCur(n.href) ? 'page' : undefined}>{n.label}</a>)}
            </div>
          </details>
        </nav>
        <script is:inline>
          // ☰ menu: a tap outside it or Escape closes it
          (function () { var m = document.querySelector('.top .menu'); if (!m) return;
            document.addEventListener('click', function (e) { if (m.open && !m.contains(e.target)) m.open = false; });
            document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && m.open) { m.open = false; m.querySelector('summary').focus(); } }); })();
        </script>
      </div>
    </header>
    <main><slot /></main>
    <footer class="foot">
      {reportUrl && <ReportButton client:idle endpoint={reportUrl} species={species} />}
      Данные: ACO 2022 (CC BY), BIRDBASE 2025 (CC BY), eBird/Clements 2025, Wikidata (CC0), Wikipedia (CC BY-SA), фото авторов с Wikimedia Commons и iNaturalist по свободным лицензиям.
    </footer>
    <script is:inline define:vars={{ base, prod }}>
      // Offline shell (see site/integrations/offline.mjs and /offline/):
      // 1) service worker; 2) «Офлайн» pill while navigator.onLine is false; 3) «Есть новая версия» pill in the same
      // header slot (online only; the two never show together)
      // (or a one-time silent reload when a stale page's fresh copy lands before the user starts reading).
      (function () {
        // the build id lives only in <meta name="build-version">, so it is the one line that differs between builds
        // (the offline-pack hash of a page ignores that meta: an unchanged page is not re-downloaded)
        var buildId = (document.querySelector('meta[name="build-version"]') || {}).content || '';
        if (prod && 'serviceWorker' in navigator) {
          navigator.serviceWorker.register(base + 'sw.js', { scope: base, updateViaCache: 'none' }).catch(function () {});
        }
        var strip = document.getElementById('offline-strip');
        function packDate() {
          try { var p = JSON.parse(localStorage.getItem('cb.offline.pack') || 'null');
            if (p && p.built) return new Date(p.built).toLocaleDateString('ru-RU'); } catch (e) {}
          return 'пакет не скачан';
        }
        function syncStrip() {
          if (!strip) return;
          strip.hidden = navigator.onLine !== false;
          if (!strip.hidden) strip.querySelector('span').textContent = packDate();
        }
        syncStrip();

        var toast = document.getElementById('new-version');
        // offline: the update pill cannot reload, so it gives way to the offline pill; back online, check again
        addEventListener('offline', function () { toast.hidden = true; syncStrip(); });
        addEventListener('online', function () { syncStrip(); checkVersion(); });
        // The worker answers the reload from its cache, which the background refresh has normally updated by
        // now. If it has not, the reloaded page is still the old build: dropping the 60 s throttle lets it
        // check version.json again and show the toast again instead of silently staying stale.
        toast.querySelector('.nv-reload').addEventListener('click', function () {
          try { sessionStorage.removeItem('cb.nv.checked'); } catch (e) {}
          location.reload();
        });
        toast.querySelector('.nv-close').addEventListener('click', function () {
          toast.hidden = true; try { sessionStorage.setItem('cb.nv.dismissed', buildId); } catch (e) {}
        });
        // «Обновить» reloads the page, which would abort an offline-pack download (OfflinePack.svelte sets
        // <html data-cb-downloading> and fires cb:download-start/-end), so the toast waits for the run to end
        function downloading() { return document.documentElement.dataset.cbDownloading === '1'; }
        function checkVersion(force) {
          if (!prod || navigator.onLine === false || downloading()) return;
          try {
            var now = Date.now(), last = +(sessionStorage.getItem('cb.nv.checked') || 0);
            if (!force && now - last < 60000) return;
            sessionStorage.setItem('cb.nv.checked', String(now));
            if (sessionStorage.getItem('cb.nv.dismissed') === buildId) return;
          } catch (e) {}
          fetch(base + 'version.json', { cache: 'no-cache' }).then(function (r) { return r.ok ? r.json() : null; })
            .then(function (v) { if (v && v.version && v.version !== buildId) showToast(); }).catch(function () {});
        }
        function showToast() {
          if (downloading() || navigator.onLine === false) return;
          try { if (sessionStorage.getItem('cb.nv.dismissed') === buildId) return; } catch (e) {}
          toast.hidden = false;
        }

        // Stale page, fresh copy: the worker answered from its cache and, once the background refresh has
        // stored the new copy, posts PAGE_REFRESHED { url, version } (sw.template.js, notifyRefreshed). If
        // that build differs from this page's and the user has not started reading (no scroll past 40 px, no
        // touch/click/key, < 15 s since load, no pack download, not /offline/ whose island keeps state), the
        // page reloads itself once, silently: the reload is answered from the cache, now the fresh copy.
        // Otherwise the toast. sessionStorage['cb.autoreload'] = that version guards against a reload loop.
        var loadedAt = Date.now();
        var interacted = location.pathname === base + 'offline/' || downloading();
        function markInteracted() { interacted = true; }
        function onScroll() { if (scrollY > 40) { interacted = true; removeEventListener('scroll', onScroll); } }
        addEventListener('scroll', onScroll, { passive: true });
        ['touchstart', 'pointerdown', 'keydown'].forEach(function (t) {
          addEventListener(t, markInteracted, { passive: true, capture: true, once: true });
        });
        document.addEventListener('cb:download-start', markInteracted);
        if (prod && 'serviceWorker' in navigator) {
          navigator.serviceWorker.addEventListener('message', function (e) {
            var d = e.data || {};
            if (d.type !== 'PAGE_REFRESHED' || !d.version || d.version === buildId) return;
            var here = new URL(location.href); here.search = ''; here.hash = '';
            if (d.url !== here.href && d.url !== here.href + '/' && d.url + '/' !== here.href) return;
            var reloaded = null;
            try { reloaded = sessionStorage.getItem('cb.autoreload'); } catch (err) {}
            if (!interacted && !downloading() && Date.now() - loadedAt < 15000 && reloaded !== d.version) {
              try { sessionStorage.setItem('cb.autoreload', d.version); } catch (err) { showToast(); return; }
              location.reload();
            } else {
              showToast();
            }
          });
        }
        document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'visible') checkVersion(); });
        document.addEventListener('cb:download-start', function () { toast.hidden = true; });
        document.addEventListener('cb:download-end', function () { checkVersion(true); });
        checkVersion();
      })();
    </script>
  </body>
</html>
<style is:global>
  :root {
    --bg: #fbfaf6; --fg: #1d1d1b; --muted: #5f6157; --line: #e3e1d8; --card: #ffffff;
    --accent: #14532d; --accent-2: #b45309; --chip: #eef3ea;
    --seen-fg: #15803d; --seen-bg: #dcfce7;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
    --bg: #131410; --fg: #ececе6; --fg: #ecece6; --muted: #a2a49a; --line: #2a2c25; --card: #1b1d17;
    --accent: #7bd389; --accent-2: #f2a24a; --chip: #232620;
    --seen-fg: #86efac; --seen-bg: rgba(34, 197, 94, .16);
  } }
  :root[data-theme="dark"] {
    --bg: #131410; --fg: #ecece6; --muted: #a2a49a; --line: #2a2c25; --card: #1b1d17;
    --accent: #7bd389; --accent-2: #f2a24a; --chip: #232620;
    --seen-fg: #86efac; --seen-bg: rgba(34, 197, 94, .16);
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  main { max-width: 960px; margin: 0 auto; padding: 16px; }
  h1 { font-size: 1.6rem; line-height: 1.2; margin: 0.2em 0 0.4em; }
  h2 { font-size: 1.2rem; margin: 1.4em 0 0.4em; }
  .top { border-bottom: 1px solid var(--line); position: sticky; top: 0; background: var(--bg); z-index: 10; }
  /* one row: brand, the offline pill (only while offline), nav pushed right; on a narrow phone the nav wraps below */
  .top-inner { max-width: 960px; margin: 0 auto; padding: 0 16px; display: flex; flex-wrap: wrap; column-gap: 10px; align-items: center; }
  .brand { font-weight: 700; color: var(--fg); white-space: nowrap; }
  .top nav { display: flex; gap: 12px; align-items: center; margin-left: auto; }
  .top nav a, .menu summary { color: var(--muted); min-height: 40px; display: inline-flex; align-items: center; padding: 0 2px; white-space: nowrap; }
  .top nav a[aria-current="page"], .menu summary.cur { color: var(--fg); box-shadow: inset 0 -2px 0 var(--accent); }
  /* offline: a small muted pill after the brand («Офлайн · 13.10.2026» / «Офлайн · пакет не скачан»), links to /offline/ */
  .offline-strip { padding: 0 8px; border-radius: 999px; background: var(--chip); color: var(--muted); font-size: .72rem; line-height: 1.6; white-space: nowrap; }
  .offline-strip[hidden] { display: none; }
  /* new build (online only, same slot as the offline pill): an accent pill, tap reloads; × hides it for this build */
  .nv-pill { display: inline-flex; align-items: center; border-radius: 999px; background: var(--accent); color: var(--bg); font-size: .72rem; line-height: 1.6; white-space: nowrap; }
  .nv-pill[hidden] { display: none; }
  .nv-pill button { border: 0; background: none; color: inherit; font: inherit; cursor: pointer; padding: 0; position: relative; }
  .nv-pill .nv-reload { padding: 0 3px 0 8px; }
  .nv-pill .nv-reload b { font-weight: 700; }
  .nv-pill .nv-close { padding: 0 7px 0 3px; opacity: .8; font-size: .95rem; line-height: 1.2; }
  /* the pill is ~19 px tall; widen the tap areas to the 40 px header row without changing its look */
  .nv-pill button::after { content: ""; position: absolute; inset: -10px 0; }
  .nv-pill .nv-close::after { inset: -10px -10px -10px 0; }
  /* ☰ menu: <details>, the panel drops below the button, aligned right */
  .menu { position: relative; }
  .menu summary { list-style: none; cursor: pointer; gap: 6px; font-size: 1.15rem; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu-cur { font-size: 1rem; }
  .menu summary.cur { color: var(--accent); }
  .menu[open] summary { color: var(--fg); }
  .menu-pop { position: absolute; right: -8px; top: 100%; min-width: 170px; padding: 4px 0; background: var(--card); border: 1px solid var(--line);
    border-radius: 10px; box-shadow: 0 4px 16px rgba(0,0,0,.15); z-index: 11; }
  .top .menu-pop a { display: flex; padding: 0 16px; min-height: 44px; color: var(--fg); }
  .top .menu-pop a[aria-current="page"] { color: var(--accent); font-weight: 600; box-shadow: none; }
  .foot { max-width: 960px; margin: 32px auto; padding: 0 16px 32px; color: var(--muted); font-size: 0.8rem; }
  .muted { color: var(--muted); }
  .sci { font-style: italic; }
  /* route days after a site name (siteDaysShort): «Чикаке 3 окт, 23–24 окт» */
  .sdays { color: var(--muted); font-size: .85em; font-weight: 400; white-space: nowrap; margin-left: .4em; }
  .chip { display: inline-block; background: var(--chip); border-radius: 999px; padding: 2px 10px; font-size: 0.8rem; margin: 0 6px 6px 0; }
  .chip.endemic { background: var(--accent); color: #fff; }
  /* seen on the trip (SeenMark.astro, data/observations.json): green check chip; .lifer = new for Anya */
  .seen { display: inline-block; font-size: .72rem; font-weight: 600; line-height: 1.5; color: var(--seen-fg); background: var(--seen-bg);
    border-radius: 999px; padding: 0 7px; white-space: nowrap; }
  .lifer { display: inline-block; font-size: .72rem; font-weight: 600; line-height: 1.5; color: var(--accent-2);
    border: 1px solid currentColor; border-radius: 999px; padding: 0 6px; white-space: nowrap; }
  a.chip.tap { display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; font-size: .9rem; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
  .grid { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .row { display: flex; gap: 12px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .thumb { width: 64px; height: 64px; border-radius: 8px; object-fit: cover; background: var(--chip); flex: none; }
  .thumb.empty { display: grid; place-items: center; color: var(--muted); font-size: 1.4rem; }
  table { border-collapse: collapse; width: 100%; }
  td, th { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  @media (max-width: 480px) {
    main { padding: 12px 16px; }
    .top nav { gap: 10px; font-size: .9rem; }
    /* no room for the section name: the underlined accent ☰ marks a current section inside the menu */
    .menu-cur { display: none; }
  }
</style>
