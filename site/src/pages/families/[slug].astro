---
import Base from '../../layouts/Base.astro';
import SpeciesRow from '../../components/SpeciesRow.astro';
import SpeciesFace from '../../components/SpeciesFace.astro';
import ThumbLightbox from '../../components/ThumbLightbox.svelte';
import ListFilter from '../../components/ListFilter.svelte';
import FilterScope from '../../components/FilterScope.astro';
import StateWord from '../../components/StateWord.astro';
import { families, speciesIndex, focusSpecies, itineraryWithSpecies, fmtDateRu, dayLabel, MEDIA_BASE, groupOfFamily, orderRu, representativeSpecies, plural, routeState, whyInteresting, cmpPlace, WHY_RU, type IndexEntry } from '@lib/data';
import { familyContent } from '@lib/content';
import { linkify } from '@lib/linkify';
export function getStaticPaths() {
  return families().map((f) => ({ params: { slug: f.slug }, props: { family: f } }));
}
const { family } = Astro.props;
const idx = speciesIndex();
const byId = new Map(idx.map((s) => [s.id, s]));
const sp = idx.filter((s) => s.family === family.code).sort((a, b) => a.taxon_order - b.taxon_order);
const fc = familyContent(family.code);
const byCode = new Map(families().map((f) => [f.code, f]));
const base = import.meta.env.BASE_URL;
const focus = focusSpecies();
const title = family.names.ru ?? family.names.en;
const group = groupOfFamily(family.code);
const ordRu = orderRu(family.order);

/* Route species of this family: highlights/focus first, then by GBIF records over all days. */
const days = itineraryWithSpecies();
const routeN = new Map<string, { n: number; hl: boolean }>();
for (const d of days) for (const s of d.species) {
  if (byId.get(s.id)?.family !== family.code) continue;
  const e = routeN.get(s.id) ?? { n: 0, hl: false };
  e.n += s.n; e.hl ||= s.highlightAt.length > 0;
  routeN.set(s.id, e);
}
const rank = (s: IndexEntry) => [focus.has(s.id) || routeN.get(s.id)?.hl ? 0 : 1, -(routeN.get(s.id)?.n ?? 0)];
const cmp = (a: IndexEntry, b: IndexEntry) => { const [x, y] = [rank(a), rank(b)]; return x[0] - y[0] || x[1] - y[1] || a.taxon_order - b.taxon_order; };
// Hero photos: 2–3 species of the family with photos, route species first, then any.
const faces = sp.filter((s) => s.photo).sort(cmp).slice(0, 3);

/* Family by itinerary day: interesting first, then by state and autumn frequency (lib cmpPlace). */
const byDay = days.map((d) => {
  const list = d.species.filter((s) => byId.get(s.id)?.family === family.code).sort(cmpPlace)
    .map((p) => ({ s: byId.get(p.id)!, p }));
  return { day: d.day, list };
}).filter((d) => d.list.length > 0);
/* All species of the family: state = best across route sites, «интересная» over the whole route. */
const rows = sp.map((s) => ({ s, state: routeState(s.id), why: whyInteresting(s.id) }));
---
<Base title={title}>
  <p class="muted crumb"><a href={`${base}families/`}>Семейства</a>{group && <> › <a href={`${base}groups/${group.id}/`}>{group.name_ru}</a></>}</p>
  <h1>{title}</h1>
  <p class="muted sub">{family.names.ru && <>{family.names.en} · </>}<span class="sci">{family.sci}</span> · {sp.length} {plural(sp.length, 'вид', 'вида', 'видов')} в Колумбии</p>
  <p class="muted ord">Отряд: {ordRu ? <>{ordRu} · <span class="sci">{family.order}</span></> : <span class="sci">{family.order}</span>}</p>
  {faces.length > 0 && (
    <div class="faces" aria-label="Фото видов семейства">{faces.map((s) => <SpeciesFace s={s} size={faces.length === 1 ? 260 : 180} />)}</div>
  )}
  {fc && (
    <section class="portrait">
      {fc.body.map((p) => <p set:html={linkify(p, base)} />)}
      {fc.recognize.length > 0 && (
        <div class="card block">
          <h2>Как узнать</h2>
          <ul>{fc.recognize.map((r) => <li>{r}</li>)}</ul>
        </div>
      )}
      {fc.confusable.length > 0 && (
        <div class="card block">
          <h2>С кем спутать</h2>
          <ul class="conf">
            {fc.confusable.map((c) => {
              const f = byCode.get(c.family);
              const reps = f ? representativeSpecies(f.code, 3) : [];
              return (
                <li>
                  {f ? (
                    <a class="cf" href={`${base}families/${f.slug}/`}><b>{f.names.ru ?? f.names.en}</b> <span class="sci">{f.sci}</span></a>
                  ) : <b>{c.family}</b>}
                  <span>{c.how}</span>
                  {reps.length > 0 && <div class="reps">{reps.map((s) => <SpeciesFace s={s} size={84} />)}</div>}
                </li>
              );
            })}
          </ul>
        </div>
      )}
      {fc.fact && <p class="fact"><b>Факт.</b> {fc.fact}</p>}
      {fc.route_note && (
        <div class="card block route">
          <h2>На маршруте</h2>
          <p set:html={linkify(fc.route_note, base)} />
        </div>
      )}
    </section>
  )}
  {byDay.length > 0 && (
    <div class="card block days">
      <h2>Это семейство по дням маршрута</h2>
      <p class="muted small">Виды семейства на локациях дня (GBIF); <span class="chip hl mini">★</span> — интересные: цели из отчётов о поездках, эндемики, узкий ареал.</p>
      <FilterScope>
        <ListFilter client:load />
        <ol class="dl">
          {byDay.map(({ day, list }) => (
            <li data-lf-group>
              <a class="dh" href={`${base}days/${day.date}/`}><b>{fmtDateRu(day.date, false)}</b> <span class="muted">· {dayLabel(day)} · {day.title_ru}</span></a>
              <div class="chips">
                {list.map(({ s, p }) => (
                  <a class={`chip sp${p.interesting ? ' hl' : ''}`} href={`${base}species/${s.id}/`} data-st={p.state} data-int={p.interesting ? '' : undefined}
                    title={[s.ru, p.interesting && `интересная: ${p.why.map((w) => WHY_RU[w]).join(', ')}`].filter(Boolean).join(' · ') || undefined}>{p.interesting && '★ '}{s.en} <StateWord state={p.state} /></a>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </FilterScope>
    </div>
  )}
  {fc && (
    <section class="portrait">
      {fc.en && (
        <details class="en" lang="en">
          <summary>English</summary>
          {fc.en.body.map((p) => <p set:html={linkify(p, base)} />)}
          {fc.en.recognize.length > 0 && (<><h3>How to recognise</h3><ul>{fc.en.recognize.map((r) => <li>{r}</li>)}</ul></>)}
          {fc.en.route_note && (<><h3>On this route</h3><p set:html={linkify(fc.en.route_note, base)} /></>)}
          {fc.en.fact && <p class="fact"><b>Fact.</b> {fc.en.fact}</p>}
        </details>
      )}
    </section>
  )}
  <FilterScope>
    <h2 class="list-h">Все виды семейства <span class="cnt muted" data-lf-summary></span></h2>
    <ListFilter client:load />
    <div>{rows.map((r) => <SpeciesRow s={r.s} state={r.state} why={r.why} />)}</div>
  </FilterScope>
  {sp.some((s) => s.photo) && <ThumbLightbox client:idle mediaBase={MEDIA_BASE} />}
</Base>
<style>
  .crumb { margin: 0; font-size: .9rem; }
  .ord { margin: 0 0 12px; font-size: .9rem; }
  h1 { margin-bottom: 2px; }
  .sub { margin: 0 0 2px; }
  .faces { display: flex; gap: 12px; overflow-x: auto; padding: 2px 0 8px; margin: 4px 0 12px; scrollbar-width: thin; }
  @media (max-width: 480px) { .faces :global(.face) { --w: 150px !important; } }
  .portrait { margin: 8px 0 12px; }
  .portrait > p { margin: 0 0 12px; }
  .block { margin: 14px 0; }
  .block h2 { font-size: 1rem; margin: 0 0 6px; }
  .block ul { margin: 0; padding-left: 1.1em; }
  .block li { margin: 4px 0; }
  .block p { margin: 0; }
  .conf { list-style: none; padding-left: 0 !important; }
  .conf li { display: flex; flex-direction: column; gap: 4px; padding: 10px 0; border-top: 1px solid var(--line); }
  .conf li:first-child { border-top: 0; padding-top: 0; }
  .conf .sci { color: var(--muted); font-style: italic; font-weight: 400; }
  .reps { display: flex; gap: 10px; overflow-x: auto; padding-top: 4px; }
  .route { border-left: 4px solid var(--accent); }
  .days .small { font-size: .85rem; margin: 0 0 8px; }
  .dl { list-style: none; padding: 0 !important; margin: 0; }
  .dl li { padding: 8px 0; border-top: 1px solid var(--line); margin: 0 !important; }
  .dl li:first-child { border-top: 0; padding-top: 0; }
  .dh { display: block; color: var(--fg); margin-bottom: 4px; font-size: .9rem; }
  .chips { display: flex; flex-wrap: wrap; }
  .chips .chip { color: var(--fg); }
  .chip.hl { background: var(--accent-2); color: #fff !important; }
  .chip.mini { padding: 0 6px; margin: 0; }
  .chip.more { color: var(--accent) !important; font-weight: 600; }
  .fact { border-left: 4px solid var(--accent-2); padding: 4px 0 4px 12px; margin: 14px 0; }
  .en { margin: 14px 0; border: 1px solid var(--line); border-radius: 12px; padding: 8px 14px; }
  .en summary { cursor: pointer; font-weight: 600; color: var(--muted); }
  .en h3 { font-size: 0.95rem; margin: 12px 0 4px; }
  .en ul { padding-left: 1.1em; margin: 0; }
  .en p { margin: 8px 0; }
  .list-h { font-size: 1.1rem; margin: 22px 0 4px; }
  .list-h .cnt { font-size: .85rem; font-weight: 500; margin-left: 6px; white-space: nowrap; }
  .chip.hl :global(.stw) { color: #fff; opacity: .85; }
</style>
