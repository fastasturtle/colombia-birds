---
/**
 * Birder's English: flashcards (WordCards.svelte) over content/vocabulary.yaml; the alphabetical list is /words/all/.
 * The words go into the page as one JSON block (<script type="application/json" id="words-data">):
 * [{en, ru, note, ex: [{id, en, ph}]}], ph = photo key from data/species_index.json (null when none);
 * the component builds image URLs as `media + ph`, media = mediaUrl('').
 */
import Base from '../../layouts/Base.astro';
import WordCards from '../../components/WordCards.svelte';
import { vocabulary } from '@lib/vocabulary';
import { mediaUrl } from '@lib/data';

const base = import.meta.env.BASE_URL;
const words = vocabulary();
const json = JSON.stringify(
  words.map((w) => ({ en: w.en, ru: w.ru, note: w.note, ex: w.examples.map((s) => ({ id: s.id, en: s.en, ph: s.photo })) })),
).replace(/</g, '\\u003c');
---
<Base title="Слова" description="Английские слова из названий и описаний птиц: карточки для заучивания и словарик">
  <h1>Английские слова</h1>
  <p class="muted lead">Слова из английских названий птиц и описаний видов нашего маршрута: окраска, части тела, повадки, места обитания. Нажмите на карточку, чтобы увидеть перевод.</p>
  <script type="application/json" id="words-data" set:html={json}></script>
  <WordCards client:load media={mediaUrl('')} />
  <p class="all"><a class="more" href={`${base}words/all/`}>Все слова ({words.length}) →</a></p>
</Base>

<style>
  .lead { margin-top: 0; }
  .all { max-width: 480px; margin: 4px auto 0; }
  .more { min-height: 44px; display: inline-flex; align-items: center; }
</style>
