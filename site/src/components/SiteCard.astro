---
/** Compact site card for the day page strip: name, elevation band, habitat in one line, link to the site page. */
import { regions, type Site } from '@lib/data';
interface Props { s: Site }
const { s } = Astro.props;
const color = regions().find((r) => r.id === s.region)?.color ?? 'var(--line)';
const base = import.meta.env.BASE_URL;
const elev = s.elev_min != null ? (s.elev_max != null && s.elev_max !== s.elev_min ? `${s.elev_min}–${s.elev_max} м` : `${s.elev_min} м`) : null;
---
<div class="card sitecard" style={`border-top: 4px solid ${color}`}>
  <strong class="sname">{s.name_ru || s.name}</strong>
  {elev && <div class="elev">{elev}</div>}
  {s.habitat_ru && <div class="muted hab" title={s.habitat_ru}>{s.habitat_ru}</div>}
  <a class="more" href={`${base}sites/${s.id}/`}>все виды и детали →</a>
</div>
<style>
  .sitecard { padding: 8px 12px 2px; min-width: 0; display: flex; flex-direction: column; font-size: .88rem; line-height: 1.35; }
  .sname { font-size: 1rem; line-height: 1.3; }
  .hab { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .more { min-height: 40px; display: inline-flex; align-items: center; margin-top: auto; }
</style>
