 * Data: content/igor-500/data.json (lib/igor500.ts): candidates per remaining site with autumn eBird/GBIF record counts.
 * Checkboxes keep their state in localStorage['igor500'] ({ species id: 1 }); one state per species across all lists.
 */
import Base from '../../layouts/Base.astro';
import { sites, plural } from '@lib/data';
import { igor500, sp, type Candidate, type Tier } from '@lib/igor500';

const base = import.meta.env.BASE_URL;
