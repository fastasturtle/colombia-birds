---
/**
 * Day page = a short study page for the evening before: facts, the day's sites, and the study list
 * (data/study_lists.json: featured = «ради чего едем», background = common birds). No study list -> no species section.
 */
import Base from '../../layouts/Base.astro';
import SiteCard from '../../components/SiteCard.astro';
import StudyTile from '../../components/StudyTile.astro';
import ThumbLightbox from '../../components/ThumbLightbox.svelte';
import {
  itinerary, sites, regions, siteSpecies, speciesIndex, groups, groupOfFamily, studyList, fmtDateRu, dayLabel, MEDIA_BASE,
  type Day, type IndexEntry, type StudyFeatured,
} from '@lib/data';
export function getStaticPaths() {
  const all = itinerary();
  return all.map((d, i) => ({ params: { date: d.date }, props: { day: d, prev: all[i - 1] ?? null, next: all[i + 1] ?? null } }));
}
interface Props { day: Day; prev: Day | null; next: Day | null }
const { day, prev, next } = Astro.props;
const siteOf = Object.fromEntries(sites().map((s) => [s.id, s]));
const daySites = day.sites.map((id) => siteOf[id]).filter(Boolean);
const region = regions().find((r) => r.id === day.region);
const idx = new Map(speciesIndex().map((s) => [s.id, s]));
const base = import.meta.env.BASE_URL;
const study = studyList(day.date);

// featured, grouped by bird group (groups.json order), taxonomic inside a group
const byGroup = new Map<string, { f: StudyFeatured; s: IndexEntry }[]>();
for (const f of study?.featured ?? []) {
  const s = idx.get(f.id)!;
  const g = groupOfFamily(s.family)?.id ?? '';
  (byGroup.get(g) ?? byGroup.set(g, []).get(g)!).push({ f, s });
}
const featuredGroups = [...groups().map((g) => ({ id: g.id, name: g.name_ru })), { id: '', name: 'Прочие' }]
  .map((g) => ({ ...g, rows: (byGroup.get(g.id) ?? []).sort((a, b) => a.s.taxon_order - b.s.taxon_order) }))
  .filter((g) => g.rows.length);
const background = (study?.background ?? []).map((b) => idx.get(b.id)!);
const hasPhotos = [...(study?.featured ?? []), ...(study?.background ?? [])].some((x) => idx.get(x.id)?.photo);
const ss = siteSpecies();
const radii = [...new Set((study?.sites.length ? study.sites : day.sites).map((id) => ss[id]?.radius_km).filter(Boolean))];
const short = (d: Day) => `${fmtDateRu(d.date, false)} · ${dayLabel(d)}`;
---
<Base title={`${fmtDateRu(day.date, false)}: ${day.title_ru}`} description={`${dayLabel(day)}: ${day.title_ru}. Что учить к вечеру: главные виды и фон.`}>
  <header class="dh" style={`border-left-color:${region?.color ?? 'var(--line)'}`}>
    <p class="muted meta">{fmtDateRu(day.date)} · {dayLabel(day)}{region && <> · {region.name_ru}</>}</p>
    <h1>{day.title_ru}</h1>
  </header>
  <table class="facts">
    <tr><th>Гид</th><td>{day.guide ?? '—'}</td></tr>
    <tr><th>Переезды</th><td>{day.travel_ru || '—'}</td></tr>
    <tr><th>Ночёвка</th><td>{day.overnight_site && siteOf[day.overnight_site] ? <a href={`${base}sites/${day.overnight_site}/`}>{day.overnight}</a> : day.overnight}{day.elev_sleep != null && <span class="muted"> · {day.elev_sleep} м</span>}</td></tr>
  </table>

  {daySites.length > 0 && <div class="strip">{daySites.map((s) => <SiteCard s={s} />)}</div>}

  {study && featuredGroups.length > 0 && (
    <section>
      <h2>Ради чего едем</h2>
      {featuredGroups.map((g) => (
        <>
          <h3 class="grp">{g.name}</h3>
          <div class="tiles">
            {g.rows.map(({ f, s }) => (
              <StudyTile s={s} highlight={f.why.includes('highlight')} endemic={f.why.includes('endemic') || s.endemic} isNew={f.why.includes('new_for_route')} />
            ))}
          </div>
        </>
      ))}
    </section>
  )}

  {study && background.length > 0 && (
    <section>
      <h2>Фон, который точно увидим</h2>
      <div class="tiles sm">{background.map((s) => <StudyTile s={s} small />)}</div>
    </section>
  )}

  {hasPhotos && <ThumbLightbox client:idle mediaBase={MEDIA_BASE} />}

  <nav class="pn">
    {prev ? <a href={`${base}days/${prev.date}/`}>← {short(prev)}</a> : <a href={base}>← Маршрут</a>}
    {next ? <a href={`${base}days/${next.date}/`}>{short(next)} →</a> : <a href={base}>Маршрут →</a>}
  </nav>
  {study && radii.length > 0 && (
    <p class="muted method">
      Списки построены по осенним находкам GBIF в радиусе {radii.join('/')} км; полный список — на {daySites.length === 1
        ? <a href={`${base}sites/${daySites[0].id}/`}>странице локации</a>
        : 'странице локации'}.
    </p>
  )}
</Base>
<style>
  .dh { border-left: 4px solid; padding-left: 10px; margin: 4px 0 10px; }
  .dh .meta { margin: 0 0 2px; font-size: .9rem; }
  .dh h1 { margin: 0; }
  .facts th { width: 96px; color: var(--muted); font-weight: 500; }
  .strip { display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); margin: 14px 0 4px; }
  .grp { font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); font-weight: 600; margin: 14px 0 6px; }
  .tiles { display: grid; gap: 10px 8px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .tiles.sm { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px 6px; }
  @media (min-width: 640px) {
    .tiles { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 14px 12px; }
    .tiles.sm { grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); }
  }
  .pn { display: flex; justify-content: space-between; gap: 12px; margin-top: 24px; padding-top: 4px; border-top: 1px solid var(--line); }
  .pn a { min-height: 44px; display: inline-flex; align-items: center; }
  .pn a:last-child { text-align: right; }
  .method { font-size: .8rem; margin-top: 8px; }
</style>
