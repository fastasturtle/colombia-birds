---
import { sites, regions, studyList, fmtDateRu, dayLabel, plural, type DayWithSpecies } from '@lib/data';
interface Props { d: DayWithSpecies; compact?: boolean; id?: string; hidden?: boolean }
const { d, compact = false, id, hidden } = Astro.props;
const day = d.day;
const siteOf = Object.fromEntries(sites().map((s) => [s.id, s]));
const color = regions().find((r) => r.id === day.region)?.color ?? 'var(--line)';
const base = import.meta.env.BASE_URL;
const study = studyList(day.date);
const n = study?.featured.length ?? 0;
const nH = study?.featured.filter((f) => f.why.includes('highlight')).length ?? 0;
---
<article class="card daycard" id={id} hidden={hidden} data-date={day.date} style={`border-left: 5px solid ${color}`}>
  <slot name="top" />
  <a class="dhead" href={`${base}days/${day.date}/`}>
    <span class="muted meta">{fmtDateRu(day.date)} · {dayLabel(day)}{day.guide && <> · гид {day.guide}</>}</span>
    <strong class="dtitle">{day.title_ru}</strong>
  </a>
  {!compact && day.travel_ru && <div class="muted small">{day.travel_ru}</div>}
  <div class="muted small">Ночёвка: {day.overnight}{day.elev_sleep != null && <> · {day.elev_sleep} м</>}</div>
  {day.sites.length > 0 && (
    <div class="sites">{day.sites.map((sid) => siteOf[sid] && <a class="chip tap" href={`${base}sites/${sid}/`}>{siteOf[sid].name_ru || siteOf[sid].name}</a>)}</div>
  )}
  {n > 0 && (
    <div class="small stats">
      {n} {plural(n, 'вид', 'вида', 'видов')} на вечер{nH > 0 && <> · <b class="hl">{nH} {plural(nH, 'изюминка', 'изюминки', 'изюминок')}</b></>}
    </div>
  )}
  <slot />
</article>
<style>
  .daycard { margin: 8px 0; }
  .dhead { display: block; color: inherit; padding: 2px 0 4px; }
  .dhead:hover { text-decoration: none; }
  .dhead:hover .dtitle { color: var(--accent); }
  .meta { display: block; font-size: .85rem; }
  .dtitle { display: block; font-size: 1.05rem; line-height: 1.3; }
  .small { font-size: .9rem; }
  .sites { margin-top: 6px; }
  .stats { margin-top: 2px; }
  .hl { color: var(--accent-2); }
</style>
