---
import Base from '../../layouts/Base.astro';
import PhotoGallery from '../../components/PhotoGallery.svelte';
import StateWord from '../../components/StateWord.astro';
import SpeciesCard from '../../components/SpeciesCard.astro';
import { speciesCard } from '@lib/content';
import { speciesIndex, species, texts, families, sites, siteSpecies, daysForSite, siteState, whyInteresting, STATE_RANK, WHY_RU, fmtDateRu, plural, MEDIA_BASE, STATUS_RU, IUCN_RU, HABITAT_RU } from '@lib/data';
export function getStaticPaths() {
  return speciesIndex().map((s) => ({ params: { id: s.id } }));
}
const { id } = Astro.params;
const sp = species(id!);
const tx = texts(id!);
const card = speciesCard(id!);
const fam = families().find((f) => f.code === sp.family.code);
const base = import.meta.env.BASE_URL;
const idx = speciesIndex();
const pos = idx.findIndex((s) => s.id === id);
const prev = pos > 0 ? idx[pos - 1] : null;
const next = pos < idx.length - 1 ? idx[pos + 1] : null;
const sameGenus = idx.filter((s) => s.sci.split(' ')[0] === sp.genus && s.id !== sp.id);
const ssAll = siteSpecies();
const whereSeen = sites()
  .map((st) => ({ st, n: ssAll[st.id]?.species.find((x) => x.id === sp.id)?.n ?? 0, state: siteState(st.id, sp.id), hl: !!st.target_species?.includes(sp.id), why: whyInteresting(sp.id, [st.id]), days: daysForSite(st.id) }))
  .filter((w) => w.n > 0 || w.hl)
  .sort((a, b) => Number(b.days.length > 0) - Number(a.days.length > 0) || STATE_RANK[b.state] - STATE_RANK[a.state] || Number(b.hl) - Number(a.hl) || b.n - a.n);
const el = sp.traits.elevation_m;
const enText = tx?.wikipedia?.en;
const ruText = tx?.wikipedia?.ru;
const descr = enText?.sections?.['Description'] ?? enText?.sections?.['Identification'] ?? null;
const title = sp.names.ru ? `${sp.names.ru} · ${sp.names.en}` : sp.names.en;
---
<Base title={title} species={sp.id} description={`${sp.names.en} (${sp.sci_name}): статус в Колумбии, высоты, биотоп, как отличить`}>
  <p class="muted"><a href={`${base}families/${fam?.slug}/`}>{fam?.names.ru ?? sp.family.en}</a> · {sp.order}</p>
  <h1>{sp.names.en}</h1>
  <p style="margin-top:-6px">
    <span class="sci">{sp.sci_name}</span> <span class="muted">{sp.authorship}</span>
    {sp.names.ru && <><br /><strong>{sp.names.ru}</strong></>}
    {sp.names.es && <span class="muted"> · исп. {sp.names.es}</span>}
  </p>
  <p>
    {sp.colombia.status.map((s) => <span class:list={['chip', { endemic: s === 'endemic' }]}>{STATUS_RU[s] ?? s}{sp.colombia.status_uncertain ? '?' : ''}</span>)}
    {sp.iucn.aco_2022 && sp.iucn.aco_2022 !== 'LC' && <span class="chip" style="background:var(--accent-2);color:#fff">IUCN {sp.iucn.aco_2022}: {IUCN_RU[sp.iucn.aco_2022]}</span>}
    {sp.traits.range_restricted ? <span class="chip">узкий ареал</span> : null}
  </p>

  {sp.photos.length > 0 ? (
    <PhotoGallery client:load photos={sp.photos} alt={sp.names.ru ?? sp.names.en} mediaBase={MEDIA_BASE} />
  ) : (
    <p class="card muted">Фото ещё не загружено. Посмотреть: <a href={sp.links.ebird} target="_blank" rel="noopener">eBird</a>{sp.links.commons_category && <>, <a href={sp.links.commons_category} target="_blank" rel="noopener">Commons</a></>}{sp.links.inaturalist && <>, <a href={sp.links.inaturalist} target="_blank" rel="noopener">iNaturalist</a></>}.</p>
  )}

  {card && <SpeciesCard card={card} />}

  <h2>Коротко</h2>
  <table>
    {el && (el.min != null || el.max != null) && <tr><th>Высоты</th><td>{el.min ?? 0}–{el.max ?? '?'} м{(el.min_extreme != null || el.max_extreme != null) && <span class="muted"> (крайние {el.min_extreme ?? el.min}–{el.max_extreme ?? el.max})</span>}</td></tr>}
    {sp.traits.primary_habitat && <tr><th>Биотоп</th><td>{HABITAT_RU[sp.traits.primary_habitat] ?? sp.traits.primary_habitat}{sp.traits.habitats.length > 1 && <span class="muted"> · {sp.traits.habitats.join(', ')}</span>}</td></tr>}
    {sp.traits.mass_g && <tr><th>Масса</th><td>{Math.round(sp.traits.mass_g)} г</td></tr>}
    {sp.traits.primary_diet && <tr><th>Питание</th><td>{sp.traits.primary_diet}{sp.traits.diet_desc && <span class="muted"> · {sp.traits.diet_desc}</span>}</td></tr>}
    <tr><th>В Колумбии</th><td>{sp.colombia.status_raw}{sp.colombia.migration_note && sp.colombia.migration_note !== sp.colombia.status_raw && <span class="muted"> · {sp.colombia.migration_note}</span>}{sp.colombia.libro_rojo && sp.colombia.libro_rojo !== 'No Evaluado' && <span class="muted"> · Libro Rojo: {sp.colombia.libro_rojo}</span>}</td></tr>
    {sp.taxonomy_note && <tr><th>Таксономия</th><td class="muted">{sp.taxonomy_note}</td></tr>}
  </table>

  <h2>Где на маршруте</h2>
  {whereSeen.length === 0 ? (
    <p class="muted">Ни на одной локации маршрута нет записей GBIF (≥ 3) и нет в отчётах.</p>
  ) : (
    <ul class="where">
      {whereSeen.map((w) => (
        <li>
          <a class="wsite" href={`${base}sites/${w.st.id}/`}>{w.st.name_ru || w.st.name}</a>
          {w.why.length > 0 && <b class="star" title={`интересная: ${w.why.map((x) => WHY_RU[x]).join(', ')}`}>★</b>}
          <StateWord state={w.state} title={w.n > 0 ? `${w.n} ${plural(w.n, 'запись', 'записи', 'записей')} GBIF` : 'нет записей GBIF рядом'} />
          {w.days.length > 0 ? <span class="wdays">{w.days.map((d) => <a class="chip tap" href={`${base}days/${d.date}/`}>{fmtDateRu(d.date, false)}{typeof d.day === 'number' && ` · д.${d.day}`}</a>)}</span> : <span class="chip muted-chip">не в плане, рядом с Боготой</span>}
        </li>
      ))}
    </ul>
  )}

  {descr && (
    <>
      <h2>Описание (Wikipedia, en)</h2>
      <p class="wiki">{descr}</p>
    </>
  )}
  {!descr && enText?.intro && (
    <>
      <h2>Wikipedia (en)</h2>
      <p class="wiki">{enText.intro}</p>
    </>
  )}
  {ruText?.intro && (
    <>
      <h2>Википедия (ru)</h2>
      <p class="wiki">{ruText.intro}</p>
    </>
  )}
  {(enText || ruText) && (
    <p class="muted" style="font-size:.8rem">
      Текст: {[enText, ruText].filter(Boolean).map((t) => <><a href={t!.url} target="_blank" rel="noopener">{t!.title}</a> </>)} — Wikipedia, <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>.
    </p>
  )}

  {sameGenus.length > 0 && (
    <>
      <h2>Тот же род в Колумбии</h2>
      <p>{sameGenus.map((s) => <a class="chip" href={`${base}species/${s.id}/`}>{s.en}</a>)}</p>
    </>
  )}

  <h2>Ссылки</h2>
  <p>
    <a class="chip" href={sp.links.ebird} target="_blank" rel="noopener">eBird</a>
    <a class="chip" href={sp.links.xeno_canto} target="_blank" rel="noopener">xeno-canto (голоса)</a>
    {sp.links.inaturalist && <a class="chip" href={sp.links.inaturalist} target="_blank" rel="noopener">iNaturalist</a>}
    {sp.links.wikipedia.en && <a class="chip" href={sp.links.wikipedia.en} target="_blank" rel="noopener">Wikipedia en</a>}
    {sp.links.wikipedia.ru && <a class="chip" href={sp.links.wikipedia.ru} target="_blank" rel="noopener">Википедия ru</a>}
    {sp.links.wikipedia.es && <a class="chip" href={sp.links.wikipedia.es} target="_blank" rel="noopener">Wikipedia es</a>}
    {sp.links.commons_category && <a class="chip" href={sp.links.commons_category} target="_blank" rel="noopener">Commons</a>}
    {sp.ids.avibase && <a class="chip" href={`https://avibase.bsc-eoc.org/species.jsp?avibaseid=${sp.ids.avibase}`} target="_blank" rel="noopener">Avibase</a>}
  </p>

  <nav class="pn">
    {prev ? <a href={`${base}species/${prev.id}/`}>← {prev.en}</a> : <span />}
    {next ? <a href={`${base}species/${next.id}/`}>{next.en} →</a> : <span />}
  </nav>
</Base>
<style>
  th { width: 110px; color: var(--muted); font-weight: 500; }
  .wiki { white-space: pre-line; }
  .where { list-style: none; padding: 0; margin: 0; }
  .where li { padding: 6px 0; border-bottom: 1px solid var(--line); display: flex; flex-wrap: wrap; align-items: center; gap: 2px 8px; }
  .wsite { font-weight: 600; min-height: 40px; display: inline-flex; align-items: center; }
  .where .chip { margin: 0; }
  .star { color: var(--accent-2); }
  .muted-chip { background: transparent; border: 1px dashed var(--line); color: var(--muted); }
  .wdays { display: flex; flex-wrap: wrap; gap: 4px; flex-basis: 100%; }
  .small { font-size: .85rem; }
  .pn { display: flex; justify-content: space-between; gap: 12px; margin-top: 24px; padding-top: 12px; border-top: 1px solid var(--line); }
</style>
