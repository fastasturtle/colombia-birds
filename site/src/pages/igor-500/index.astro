]);
const SITE_ORDER: [string, string][] = [
  ['la-nutria', ''], ['km-42', ''], ['finca-maragricola', ''], ['playa-del-morro', ''], ['tumaco', ''], ['la-florida', 'Богота, резерв 24.10'],
];
const TIER_RU: Record<Tier, string> = { sure: 'Почти наверняка', likely: 'Вероятно', chance: 'Шанс' };
const TIER_NOTE: Record<Tier, string> = { sure: '≥ 20 осенних записей', likely: '5–19 записей', chance: '1–4 записи, только особые цели' };
const siteLists = SITE_ORDER.filter(([id]) => d.sites[id]).map(([id, tag]) => {
  const all = [...d.sites[id]].sort((a, b) => b.n_aut - a.n_aut || a.en.localeCompare(b.en));
  const tiers = (['sure', 'likely', 'chance'] as Tier[]).map((t) => ({
    t, rows: all.filter((c) => c.tier === t && (t !== 'chance' || (CHANCE_KEEP.has(c.id) && !(id === 'la-florida' && c.id === 'steatornis-caripensis')))),
  })).filter((x) => x.rows.length);
  const cnt = (t: Tier) => all.filter((c) => c.tier === t).length;
  const name = id === 'la-florida' ? 'Parque La Florida' : siteRu(id);
  return { id, tag, name, tiers, sure: cnt('sure'), likely: cnt('likely') };
});
