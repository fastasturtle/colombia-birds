---
// Old /route/ URL: the route is now the homepage.
const home = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${home}`} />
    <link rel="canonical" href={home} />
    <script is:inline define:vars={{ home }}>
      // keep old deep links: #<site-id> -> sites/<id>/, #d<date> -> days/<date>/
      const h = decodeURIComponent(location.hash.slice(1));
      if (/^d\d{4}-\d{2}-\d{2}$/.test(h)) location.replace(`${home}days/${h.slice(1)}/`);
      else if (/^[a-z0-9-]+$/.test(h)) location.replace(`${home}sites/${h}/`);
    </script>
    <title>Маршрут · Птицы Колумбии</title>
  </head>
  <body><p>Маршрут переехал на <a href={home}>главную</a>.</p></body>
</html>
