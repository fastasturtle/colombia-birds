---
/**
 * Wrapper for a static species list that follows the site-wide filter (lib/filter.ts, ListFilter.svelte).
 * Children mark items with data-st / data-int / data-nend / data-end / data-new and groups with data-lf-group. The inline script at the
 * end applies the saved filter while the page is still parsing, so the first paint is already filtered.
 */
import { applyFilterDom, readFilter } from '@lib/filter';
interface Props { class?: string }
const { class: cls } = Astro.props;
const js = `(${applyFilterDom.toString()})(document.currentScript.parentElement,(${readFilter.toString()})())`;
---
<div class:list={['lf-scope', cls]} data-lf-scope data-lv="maybe" data-tag="all">
  <slot />
  <p class="lf-empty muted" data-lf-empty hidden>Под этот фильтр видов нет.</p>
  <script is:inline set:html={js}></script>
</div>
<style is:global>
  [data-lf-scope][data-lv="sure"] [data-st="maybe"],
  [data-lf-scope][data-lv="sure"] [data-st="unlikely"],
  [data-lf-scope][data-lv="maybe"] [data-st="unlikely"],
  [data-lf-scope][data-tag="int"] [data-st]:not([data-int]),
  [data-lf-scope][data-tag="near"] [data-st]:not([data-nend]),
  [data-lf-scope][data-tag="end"] [data-st]:not([data-end]) { display: none !important; }
  .lf-empty { margin: 8px 0; }
</style>
