const need = d.goal - d.species;
const siteOf = new Map(sites().map((s) => [s.id, s]));
const siteRu = (id: string) => siteOf.get(id)?.name_ru ?? id;
const asOfRu = (() => { const [date, time] = d.as_of.split(' '); const [, m, dd] = date.split('-'); return `${dd}.${m} ${time}`; })();

// one name record per species id: data.json first (Russian name of the derivation), then the site's index
const cand = new Map<string, Candidate>();
for (const l of Object.values(d.sites)) for (const c of l) if (!cand.has(c.id)) cand.set(c.id, c);
const nm = (id: string) => {
  const s = sp(id);
  return { id, en: s.en, sci: s.sci, ru: cand.get(id)?.ru ?? s.ru };
};
const href = (id: string) => `${base}species/${id}/`;

